# NOTE: MWT1 is Apple M4 / Metal — use PyTorch MPS (experimental), not CUDA.
# Paths: /Volumes/AlanTBrain/Composite3DGen/tools/ (live layout).
# Agent-worker lacks FDA on AlanTBrain — enable/run via Terminal or grant FDA.
#
#   ~/.config/systemd/user/composite3dgen-triposr.service
#
# Pin: 107cefdc244c39106fa830359024f6a2f1c78871

[Unit]
Description=Composite3DGen TripoSR env smoke (example oneshot)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/Volumes/AlanTBrain/Composite3DGen/tools/TripoSR
Environment=PATH=/Volumes/AlanTBrain/Composite3DGen/tools/.venv/bin:/opt/homebrew/bin:/usr/bin
ExecStart=/Volumes/AlanTBrain/Composite3DGen/tools/.venv/bin/python run.py --help
# Real reconstruct (MPS):
#   python run.py /path/to/input.png --output-dir /path/to/out \
#     --model-save-format glb --device mps

[Install]
WantedBy=default.target

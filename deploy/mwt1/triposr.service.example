# Example systemd user unit for documenting a pinned TripoSR checkout on MWT1.
# Jobs are driven over SSH from the controller — this is not a long-running daemon.
# Never embed API keys or Hugging Face tokens here.
#
#   ~/.config/systemd/user/composite3dgen-triposr.service
#
# Adjust paths after LAN verify. Pin:
#   107cefdc244c39106fa830359024f6a2f1c78871

[Unit]
Description=Composite3DGen TripoSR env smoke (example oneshot)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/composite3dgen/vendor/TripoSR
# Prefer the venv created during install (verify on LAN):
ExecStart=%h/composite3dgen/vendor/TripoSR/.venv/bin/python run.py --help
# Real reconstruct:
#   python run.py /path/to/input.png --output-dir /path/to/out --model-save-format glb

[Install]
WantedBy=default.target
